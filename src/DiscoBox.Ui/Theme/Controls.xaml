<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiscoBox.Ui.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="NavTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <ContentPresenter Margin="14,0" VerticalAlignment="Center"/>
            <Border x:Name="Underline"
                    Height="2"
                    Background="{StaticResource Brush.Accent}"
                    VerticalAlignment="Bottom"
                    Margin="14,0"
                    Visibility="Collapsed"
                    SnapsToDevicePixels="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
              <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,0"
                      Background="Transparent"/>
            <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Hairline}"
                    BorderThickness="0,1,0,0" Padding="0,14,0,0">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Background="Transparent">
            <ContentPresenter ContentSource="Header" Margin="14,9" VerticalAlignment="Center"/>
            <Border x:Name="Underline" Height="2" Background="{StaticResource Brush.Accent}"
                    VerticalAlignment="Bottom" Margin="14,0" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
              <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:StatusChip}">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:StatusChip}">
          <Border x:Name="Bd"
                  Background="{StaticResource Brush.Chip.Neutral}"
                  CornerRadius="10"
                  Padding="8,2"
                  HorizontalAlignment="Left"
                  SnapsToDevicePixels="True">
            <TextBlock x:Name="Txt"
                       Text="{TemplateBinding DisplayText}"
                       FontSize="{StaticResource Size.Tiny}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}"
                       VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Status" Value="valid">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Success}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Success}"/>
            </Trigger>
            <Trigger Property="Status" Value="success">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Success}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Success}"/>
            </Trigger>
            <Trigger Property="Status" Value="free">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Success}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Success}"/>
            </Trigger>
            <Trigger Property="Status" Value="invalid">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Danger}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/>
            </Trigger>
            <Trigger Property="Status" Value="failed">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Danger}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/>
            </Trigger>
            <Trigger Property="Status" Value="dead">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Danger}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/>
            </Trigger>
            <Trigger Property="Status" Value="locked">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Warning}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/>
            </Trigger>
            <Trigger Property="Status" Value="limited">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Warning}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/>
            </Trigger>
            <Trigger Property="Status" Value="running">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Accent}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="Status" Value="bound">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Chip.Accent}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
