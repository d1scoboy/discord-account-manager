<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <SolidColorBrush x:Key="Brush.Window" Color="#FF131417"/>
  <SolidColorBrush x:Key="Brush.Panel" Color="#591C1E22"/>
  <SolidColorBrush x:Key="Brush.PanelStrong" Color="#8C202226"/>
  <SolidColorBrush x:Key="Brush.Input" Color="#40101214"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Selected" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Hairline" Color="#2EFFFFFF"/>
  <SolidColorBrush x:Key="Brush.HairlineStrong" Color="#40FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Popup" Color="#FF212327"/>
  <SolidColorBrush x:Key="Brush.Bg.Tooltip" Color="#FF101214"/>

  <SolidColorBrush x:Key="Brush.Accent" Color="#5865F2"/>
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#4752C4"/>
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#3C45A5"/>

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#ECEEF0"/>
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B5BAC1"/>
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7C818A"/>
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#565B63"/>
  <SolidColorBrush x:Key="Brush.Text.Link" Color="#00A8FC"/>

  <SolidColorBrush x:Key="Brush.Status.Success" Color="#23A55A"/>
  <SolidColorBrush x:Key="Brush.Status.Danger" Color="#F23F43"/>
  <SolidColorBrush x:Key="Brush.Status.Warning" Color="#F0B232"/>

  <SolidColorBrush x:Key="Brush.Chip.Success" Color="#2E23A55A"/>
  <SolidColorBrush x:Key="Brush.Chip.Danger" Color="#2EF23F43"/>
  <SolidColorBrush x:Key="Brush.Chip.Warning" Color="#2EF0B232"/>
  <SolidColorBrush x:Key="Brush.Chip.Accent" Color="#2E5865F2"/>
  <SolidColorBrush x:Key="Brush.Chip.Neutral" Color="#247C818A"/>

  <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="#3DFFFFFF"/>

  <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="Size.Title">18</sys:Double>
  <sys:Double x:Key="Size.Subtitle">14</sys:Double>
  <sys:Double x:Key="Size.Body">13</sys:Double>
  <sys:Double x:Key="Size.Small">12</sys:Double>
  <sys:Double x:Key="Size.Tiny">11</sys:Double>

</ResourceDictionary>
