<UserControl x:Class="DiscoBox.ProfileManager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource Text.PageTitle}"/>

        <StackPanel Grid.Row="1" Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Storage" Style="{StaticResource Text.SectionTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Data directory" Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding DataDir, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" Width="460"
                                 HorizontalAlignment="Left"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Browse"
                                Margin="8,0,0,0" Command="{Binding BrowseDataDirCommand}"/>
                    </Grid>
                    <TextBlock Text="Accounts, proxies, jobs, profiles and logs live here."
                               Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Browser and proxy bridge" Style="{StaticResource Text.SectionTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Chrome path" Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ChromePath, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" Width="340"
                                 HorizontalAlignment="Left"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Detect"
                                Margin="8,0,0,0" Command="{Binding DetectChromeCommand}"/>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Browse"
                                Margin="4,0,0,0" Command="{Binding BrowseChromeCommand}"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="gost bridge" Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding GostPath, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" Width="340"
                                 HorizontalAlignment="Left"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Browse"
                                Margin="8,0,0,0" Command="{Binding BrowseGostCommand}"/>
                    </Grid>
                    <TextBlock Text="gost bridges authenticated proxies into Chrome sessions. Official go-gost releases only."
                               Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Runtime" Style="{StaticResource Text.SectionTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Task workers" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </StackPanel>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Log level" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding FooterMessage}" Style="{StaticResource Text.Muted}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
