<Window x:Class="DiscoBox.ProfileManager.Views.Dialogs.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:DiscoBox.Ui.Controls;assembly=DiscoBox.Ui"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterOwner"
        Title="Import accounts" Width="720" SizeToContent="Height">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            GlassFrameThickness="1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Brush.HairlineStrong}" BorderThickness="1">
    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Import accounts" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="Source (one account per line, # comments skipped)"
                           Style="{StaticResource Text.Muted}"/>
                <Button Style="{StaticResource GhostButton}" Content="Load from file..."
                        HorizontalAlignment="Right" Padding="8,3" FontSize="12"
                        Command="{Binding LoadFileCommand}"/>
            </Grid>
            <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                     Height="150" Margin="0,6,0,0" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Format" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Group" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Batch tag" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="Proxy policy" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ProxyPolicies}" SelectedItem="{Binding ProxyPolicy}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Analyze (dry-run)"
                    HorizontalAlignment="Right" Command="{Binding AnalyzeCommand}"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0"
              Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox ItemsSource="{Binding Report}" Height="170"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LineNumber}"
                                       Style="{StaticResource Text.Muted}" FontFamily="Consolas"/>
                            <ui:StatusChip Grid.Column="1" Status="{Binding Action}" Text="{Binding ActionText}"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Raw}" FontFamily="Consolas" FontSize="12"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Close_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Import" Margin="8,0,0,0"
                        IsEnabled="{Binding CanImport}" Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
