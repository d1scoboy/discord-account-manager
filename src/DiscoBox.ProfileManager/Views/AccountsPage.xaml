<UserControl x:Class="DiscoBox.ProfileManager.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DiscoBox.Ui.Controls;assembly=DiscoBox.Ui">
    <UserControl.Resources>
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Open card"
                      Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Open account in Chrome"
                      Command="{Binding DataContext.OpenAccountOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Edit"
                      Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Check status"
                      Command="{Binding DataContext.CheckOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Set proxy..."
                      Command="{Binding DataContext.SetProxyOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Use random pool"
                      Command="{Binding DataContext.UseRandomOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Delete"
                      Command="{Binding DataContext.DeleteOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Accounts" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}"
                           Margin="12,0,0,2" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding ScopeFilters}" SelectedItem="{Binding ScopeFilter}" Width="180"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="120" Margin="8,0,0,0"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" Width="26" Height="26"
                        Margin="8,0,0,0" Command="{Binding ManageGroupsCommand}"
                        ToolTip="Manage groups and tags"/>
                <Button Style="{StaticResource GhostButton}" Content="Clear" Margin="8,0,0,0"
                        Command="{Binding ClearFiltersCommand}" ToolTip="Reset search and filters"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}" Content="Add account" Command="{Binding AddCommand}"/>
                <Button Content="Import" Margin="8,0,0,0" Command="{Binding ImportCommand}"/>
                <Button Content="Export" Margin="8,0,0,0" Command="{Binding ExportCommand}"/>
                <Border Width="1" Margin="12,4" Background="{StaticResource Brush.Hairline}"/>
                <Button Content="Select shown" Click="SelectShown_Click" ToolTip="Select every visible account"/>
                <Button Content="Check" Margin="8,0,0,0" IsEnabled="{Binding HasSelection}"
                        Command="{Binding CheckSelectedCommand}"/>
                <Button Content="Set proxy" Margin="8,0,0,0" IsEnabled="{Binding HasSelection}"
                        Command="{Binding SetProxyCommand}"/>
                <Button Content="Open account" Margin="8,0,0,0" IsEnabled="{Binding HasSelection}"
                        Command="{Binding OpenAccountCommand}"/>
                <Button Style="{StaticResource DangerButton}" Content="Delete" Margin="8,0,0,0"
                        IsEnabled="{Binding HasSelection}" Command="{Binding DeleteSelectedCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="10,14,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ACCOUNT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,6"/>
            <TextBlock Grid.Column="1" Text="STATUS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
            <TextBlock Grid.Column="2" Text="TOKEN" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
            <TextBlock Grid.Column="3" Text="CHECKED" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
            <TextBlock Grid.Column="4" Text="PROXY" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
            <TextBlock Grid.Column="5" Text="LAST TASK" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,2,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                        Padding="0,7"
                                        Command="{Binding DataContext.ToggleSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Select all in group" Click="GroupSelectAll_Click"
                                                      Tag="{Binding Name}"/>
                                            <MenuItem Header="Toggle collapse"
                                                      Command="{Binding DataContext.ToggleSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE70D;" FontFamily="{StaticResource Font.Icon}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="0" Text="&#xE76C;" FontFamily="{StaticResource Font.Icon}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisInverse}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Primary}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText, StringFormat='({0})'}"
                                                   FontSize="12" Foreground="{StaticResource Brush.Text.Muted}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Border Style="{StaticResource Divider}" Margin="0,0,0,4"/>
                                <ListBox Style="{StaticResource PlainListBox}"
                                         ItemsSource="{Binding Accounts}"
                                         SelectionMode="Extended"
                                         Tag="{Binding Name}"
                                         Loaded="SectionList_Loaded"
                                         Unloaded="SectionList_Unloaded"
                                         SelectionChanged="SectionList_SelectionChanged"
                                         MouseDoubleClick="SectionList_MouseDoubleClick"
                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="230"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Username}"
                                                           Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                                                <ui:StatusChip Grid.Column="1" Status="{Binding Status}"
                                                               Text="{Binding StatusText}" Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TokenMasked}"
                                                           Style="{StaticResource Text.Mono}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding LastChecked}"
                                                           Style="{StaticResource Text.Muted}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ProxyLabel}"
                                                           Style="{StaticResource Text.Mono}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasLastTask, Converter={StaticResource BoolToVis}}">
                                                    <ui:StatusChip Status="{Binding LastTaskResult}" />
                                                    <TextBlock Text="{Binding LastTaskName}" Style="{StaticResource Text.Mono}"
                                                               Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding LastTaskTime}" Style="{StaticResource Text.Muted}"
                                                               Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="5" Text="—" Style="{StaticResource Text.Muted}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding HasLastTask, Converter={StaticResource BoolToVisInverse}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EmptyTitle}"
                           Style="{StaticResource Text.SectionTitle}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyHint}"
                           Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Import accounts"
                            Margin="8,0,0,0" Command="{Binding ImportCommand}"/>
                </StackPanel>
            </StackPanel>

            <Border Background="#99131417"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
                    <ProgressBar IsIndeterminate="True"/>
                    <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding FooterMessage}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
            <TextBlock Text="Double-click a row for the account card. Right-click for actions."
                       Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
