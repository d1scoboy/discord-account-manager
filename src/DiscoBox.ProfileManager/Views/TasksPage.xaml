<UserControl x:Class="DiscoBox.ProfileManager.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DiscoBox.Ui.Controls;assembly=DiscoBox.Ui">
    <Grid Margin="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tasks" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}"
                           Margin="12,0,0,2" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="Selection" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Selections}" SelectedItem="{Binding Selection}" Width="170"/>
                </StackPanel>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Action" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Width="150"/>
                </StackPanel>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Workers" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" Width="60"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="Create task"
                        Margin="16,15,0,0" Command="{Binding CreateJobCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                               VerticalAlignment="Center"/>
                                    <ui:StatusChip HorizontalAlignment="Right" Status="{Binding Status}"
                                                   Text="{Binding StatusText}"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding CountersText}" Style="{StaticResource Text.Muted}" FontSize="11"/>
                                    <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource Text.Muted}" FontSize="11"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No tasks yet. Create one above to see runs and live trace here."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Jobs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Column="1" Text="Select a task to see its runs and live trace."
                       Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasSelectedJob, Converter={StaticResource BoolToVisInverse}}"/>

            <Grid Grid.Column="1" Margin="16,0,0,0"
                  Visibility="{Binding DataContext.HasSelectedJob, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.DataContext>
                    <Binding Path="SelectedJob"/>
                </Grid.DataContext>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Runs" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,6"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Runs}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Account}" Style="{StaticResource Text.Body}"/>
                                    <ui:StatusChip Grid.Column="1" Status="{Binding Status}" Text="{Binding StatusText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Text.Muted}"
                                               FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Trace" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" Background="{StaticResource Brush.Input}"
                            BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                            <ItemsControl ItemsSource="{Binding Trace}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                   Foreground="{StaticResource Brush.Text.Secondary}">
                                            <Run Text="{Binding Time, Mode=OneWay}"/>
                                            <Run Text="  " />
                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Retry failed" Command="{Binding DataContext.RetryFailedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Style="{StaticResource GhostButton}" Content="Cancel job" Margin="8,0,0,0"
                            Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding FooterMessage}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
