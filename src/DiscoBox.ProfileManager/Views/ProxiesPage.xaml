<UserControl x:Class="DiscoBox.ProfileManager.Views.ProxiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DiscoBox.Ui.Controls;assembly=DiscoBox.Ui">
    <Grid Margin="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Proxies" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}"
                           Margin="12,0,0,2" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="120"/>
                <Button Style="{StaticResource GhostButton}" Content="Clear" Margin="8,0,0,0"
                        Click="ClearFilters_Click" ToolTip="Reset search and filter"/>
                <Button Style="{StaticResource GhostButton}" Content="Select shown" Margin="8,0,0,0"
                        Click="SelectShown_Click" ToolTip="Select every visible proxy line"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}" Content="Add proxy" Command="{Binding AddProxyCommand}"/>
                <Button Content="Check" Margin="8,0,0,0" IsEnabled="{Binding HasSelection}"
                        Command="{Binding CheckSelectedCommand}"/>
                <Button Style="{StaticResource DangerButton}" Content="Delete" Margin="8,0,0,0"
                        IsEnabled="{Binding HasSelection}" Command="{Binding DeleteSelectedCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="10,14,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ENDPOINT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,6"/>
            <TextBlock Grid.Column="1" Text="STATUS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
            <TextBlock Grid.Column="2" Text="EXIT IP" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
            <TextBlock Grid.Column="3" Text="CHECKED" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="10,0,0,6"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,2,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                        Padding="0,7"
                                        Command="{Binding DataContext.ToggleSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE70D;" FontFamily="{StaticResource Font.Icon}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="0" Text="&#xE76C;" FontFamily="{StaticResource Font.Icon}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisInverse}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Primary}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText, StringFormat='({0})'}"
                                                   FontSize="12" Foreground="{StaticResource Brush.Text.Muted}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Border Style="{StaticResource Divider}" Margin="0,0,0,4"/>
                                <ListBox Style="{StaticResource PlainListBox}"
                                         ItemsSource="{Binding Proxies}"
                                         SelectionMode="Extended"
                                         Tag="{Binding Name}"
                                         Loaded="SectionList_Loaded"
                                         Unloaded="SectionList_Unloaded"
                                         SelectionChanged="SectionList_SelectionChanged"
                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Endpoint}"
                                                           Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                                <ui:StatusChip Grid.Column="1" Status="{Binding Status}"
                                                               Text="{Binding StatusText}" Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ExitIp}"
                                                           Style="{StaticResource Text.Mono}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding LastCheck}"
                                                           Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="No proxy lines match." Style="{StaticResource Text.SectionTitle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add a manual proxy to fill the pool."
                           Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Add proxy"
                        HorizontalAlignment="Center" Command="{Binding AddProxyCommand}"/>
            </StackPanel>

            <Border Background="#99131417"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
                    <ProgressBar IsIndeterminate="True"/>
                    <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding FooterMessage}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
            <TextBlock Text="Valid lines are handed out to random-mode accounts while a task runs."
                       Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
