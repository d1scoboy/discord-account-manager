<Window x:Class="DiscoBox.ProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DiscoBox.ProfileManager.ViewModels"
        xmlns:views="clr-namespace:DiscoBox.ProfileManager.Views"
        Title="DiscoBox Profile Manager"
        Width="1180" Height="720" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Brush.Bg.Base}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        FontSize="{StaticResource Size.Body}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AccountsPageViewModel}">
            <views:AccountsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProxiesPageViewModel}">
            <views:ProxiesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksPageViewModel}">
            <views:TasksPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Deep}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="DISCOBOX" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Text.Secondary}"/>
                <TextBlock Text="Profile Manager" FontSize="12" Margin="8,0,0,0"
                           Foreground="{StaticResource Brush.Text.Muted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click"
                        ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                        Click="Maximize_Click" ToolTip="Maximize"/>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Deep}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,20,16,22">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{StaticResource Brush.Accent}">
                            <TextBlock Text="D" FontSize="16" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DiscoBox" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"/>
                            <TextBlock Text="PROFILE MANAGER" FontSize="9" Margin="0,1,0,0"
                                       Foreground="{StaticResource Brush.Text.Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="v0.1.0" FontSize="11" Margin="22,0,0,14"
                               Foreground="{StaticResource Brush.Text.Muted}"/>

                    <StackPanel>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True"
                                     Command="{Binding NavigateCommand}" CommandParameter="accounts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Text.Icon}" FontSize="16"/>
                                <TextBlock Text="Accounts" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}"
                                     Command="{Binding NavigateCommand}" CommandParameter="proxies">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Text.Icon}" FontSize="16"/>
                                <TextBlock Text="Proxies" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}"
                                     Command="{Binding NavigateCommand}" CommandParameter="tasks">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" Style="{StaticResource Text.Icon}" FontSize="16"/>
                                <TextBlock Text="Tasks" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Margin="0,16,0,0"
                                     Command="{Binding NavigateCommand}" CommandParameter="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="16"/>
                                <TextBlock Text="Settings" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>
